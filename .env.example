# ==============================================================
# CloudPix — senarai kunci yang anda perlu sediakan
# JANGAN isi fail ini dengan nilai sebenar dan commit ke GitHub.
# Nilai sebenar dimasukkan sebagai GitHub Secrets (lihat documentation/SETUP-BM.md).
# ==============================================================

# ---------- RAHSIA (pelayan sahaja → GitHub Secrets) ----------
# Supabase → Account (ikon profil) → Access Tokens → Generate new token
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx
# Supabase → Project Settings → General → Reference ID
SUPABASE_PROJECT_REF=abcdefghijklmnop
# Supabase → Connect → Session pooler → URI (gantikan [YOUR-PASSWORD])
SUPABASE_DB_URL=postgresql://postgres.abcdefghijklmnop:KATA_LALUAN@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Cloudflare → R2 → Account ID (di kanan halaman R2 Overview)
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Cloudflare → R2 → Manage API tokens → Create (Object Read & Write, bucket cloudpix-media sahaja)
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET=cloudpix-media

# Rentetan rawak sekurang-kurangnya 32 aksara (untuk tugas pembersihan harian)
CRON_SECRET=tukar-kepada-rentetan-rawak-panjang-anda

# Fasa 3 (web) — Cloudflare → My Profile → API Tokens → "Edit Cloudflare Workers" template
CLOUDFLARE_API_TOKEN=xxxxxxxx
CLOUDFLARE_ACCOUNT_ID=xxxxxxxx

# ---------- AWAM (selamat diletak dalam app/web) → GitHub Variables ----------
# Supabase → Project Settings → API Keys
VITE_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxx
# Alamat web selepas deploy ke Cloudflare Pages
PUBLIC_WEB_URL=https://cloudpix.pages.dev
ALLOWED_ORIGINS=https://cloudpix.pages.dev,http://localhost:5173
